COMPOSE_PROJECT_NAME=licai

APP_NAME="Lǐcái"
APP_ENV=local
APP_DOMAIN=licai.localhost
APP_URL=https://${APP_DOMAIN}

# Base SQLite (chemin dans le conteneur, volume ./data)
DATABASE_URL=file:/app/data/licai.db

# Auth (NextAuth v5) — générer avec: openssl rand -base64 32
NEXTAUTH_URL=https://${APP_DOMAIN}
NEXTAUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# Assistant IA (optionnel)
ANTHROPIC_API_KEY=

# E-mails (réinitialisation de mot de passe) — sans configuration, le lien est écrit dans les logs du serveur
# Option 1 : Resend
RESEND_API_KEY=
# Option 2 : SMTP, ex. smtps://user:pass@smtp.exemple.fr:465
SMTP_URL=
MAIL_FROM="Lǐcái <no-reply@votre-domaine.fr>"

# Démo : purge des foyers de démonstration plus anciens que N heures (voir /api/demo)
DEMO_TTL_HOURS=24
